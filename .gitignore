# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Entornos virtuales y dependencias del frontal
.venv/
venv/
env/
node_modules/
frontal/web/dist/

# Secretos: nunca se versionan, tampoco como ejemplo
.env
.env.*
*.env
*.pem
*.key
*.pfx
*.p12

# Paquetes y ZIP generados (se identifican por su SHA-256); excepciones versionadas abajo
*.zip
*.whl
!sandbox/MontserratVF.zip
!frontal/bff/reproduccion/paquete/*.zip

# Salidas generadas por las pruebas y los scripts (aquí va también la tarifa real: salidas/rate-card.json)
salidas/
_salidas/
*.log
frontal/evidencias/
frontal/.descargas/
frontal/web/test-results/
frontal/web/playwright-report/

# Configuración real: solo local. Se versionan únicamente las plantillas *.ejemplo*
config/entorno.local.json
config/*.local.*
!config/*.local.txt.ejemplo
manifiesto.json
agentes/despliegue.json

# Evidencias de pruebas reales y líneas base de entornos concretos: no se publican
pruebas/
_baseline/

# Sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
