{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preventa:catalogo:catalogo_referencias_azure:1",
  "title": "Catálogo de referencias Azure para preventa de IA y datos (catalogo/catalogo_referencias_azure.json)",
  "description": "Fuente enriquecida de BD. De aquí se derivan el catálogo de componentes del sandbox (esquemas/catalogo_componentes.json) y la tabla de las instrucciones del experto y del verificador. Cada URL y cada serviceName se comprueban con catalogo/comprobar_catalogo.py; la comprobación queda en el bloque comprobacion de cada entrada. Subconjunto de CONTRATOS.md §12. Desde I1.2 (F2): alias con fuente de Learn por alias, región UE recomendada con su fuente, regiones vetadas y con restricciones, y el registro fuentes_comprobadas (HTTP y título de cada URL usada, consultadas el mismo día).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "fecha",
    "fuente_precios",
    "componentes"
  ],
  "properties": {
    "schema": {
      "const": "preventa-catalogo-referencias/1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "fecha": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fuente_precios": {
      "const": "https://prices.azure.com/api/retail/prices"
    },
    "componentes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": {
        "$ref": "#/$defs/componente"
      }
    },
    "fuentes_comprobadas": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/fuente"
      }
    },
    "precios_auxiliares": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/auxiliar"
      },
      "description": "Lista blanca de serviceName de servicios auxiliares sin componente propio: solo valen como precio auxiliar de un componente con catalogo_id y nunca identifican un servicio (decisión del PM, I1.2)."
    },
    "casos_uso": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "descripcion",
          "factores"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]{3,40}$"
          },
          "descripcion": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          },
          "factores": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/factor"
            }
          }
        }
      },
      "description": "I1.7 (decisión 2 del comercial): factores estándar por caso de uso, con fuente."
    },
    "ciclo_vida_modelos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/ciclo_vida"
      },
      "description": "I1.7: GA y retirada publicada (o null) de cada modelo con plantilla."
    },
    "modelo_por_defecto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componente",
        "modelo",
        "plantillas",
        "region",
        "despliegue",
        "motivo",
        "fuente_url",
        "region_fuente_url",
        "consultado"
      ],
      "properties": {
        "componente": {
          "const": "az-foundry"
        },
        "modelo": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"
        },
        "plantillas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"
          }
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]+[a-z0-9]*$"
        },
        "despliegue": {
          "const": "DataZoneStandard"
        },
        "motivo": {
          "type": "string",
          "minLength": 20,
          "maxLength": 400
        },
        "fuente_url": {
          "type": "string",
          "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
        },
        "region_fuente_url": {
          "type": "string",
          "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
        },
        "consultado": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "arquitecturas_referencia": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titulo",
          "url",
          "consultado",
          "cuando_usar"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"
          },
          "titulo": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
          },
          "consultado": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "cuando_usar": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          }
        }
      },
      "description": "I1.7: arquitecturas de referencia oficiales; el experto elige el id y el núcleo pone la URL."
    },
    "computo_por_defecto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componente",
        "nivel",
        "plantillas",
        "motivo",
        "fuente_url",
        "consultado"
      ],
      "properties": {
        "componente": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"
        },
        "nivel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "plantillas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"
          }
        },
        "motivo": {
          "type": "string",
          "minLength": 20,
          "maxLength": 400
        },
        "fuente_url": {
          "type": "string",
          "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
        },
        "consultado": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "filas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^az-[a-z0-9-]{2,40}$"
          },
          "description": "I1.8 (REVERIF17-2): filas de la clase cómputo (lo lee experto.filas_computo)."
        }
      },
      "description": "PR17-4 (arreglos I1.7): cómputo por defecto; con él no hace falta justificacion_nivel, con cualquier otro cómputo con niveles sí (cita de dimensionamiento)."
    }
  },
  "$defs": {
    "componente": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre_oficial",
        "alias",
        "capa",
        "cuando_usar",
        "referencia_url",
        "referencia_url_propuesta",
        "service_name_precios",
        "producto_precios",
        "nota",
        "comprobacion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^az-[a-z0-9-]{2,40}$"
        },
        "nombre_oficial": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "alias": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nombre",
              "fuente_url"
            ],
            "properties": {
              "nombre": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80,
                "pattern": "^\\S(.*\\S)?$"
              },
              "fuente_url": {
                "type": "string",
                "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
              }
            }
          }
        },
        "capa": {
          "enum": [
            "usuarios_canales",
            "aplicacion_integracion",
            "ia",
            "datos_conocimiento",
            "identidad_seguridad_red",
            "operacion_observabilidad"
          ]
        },
        "cuando_usar": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300
        },
        "referencia_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
        },
        "referencia_url_propuesta": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
        },
        "service_name_precios": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 80
        },
        "producto_precios": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 80
        },
        "nota": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 10,
          "maxLength": 400
        },
        "comprobacion": {
          "$ref": "#/$defs/comprobacion"
        },
        "region_ue": {
          "type": "string",
          "pattern": "^[a-z]+[a-z0-9]*$"
        },
        "regiones_no_admitidas": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region",
              "motivo",
              "fuente_url",
              "consultado"
            ],
            "properties": {
              "region": {
                "type": "string",
                "pattern": "^[a-z]+[a-z0-9]*$"
              },
              "motivo": {
                "type": "string",
                "minLength": 10,
                "maxLength": 300
              },
              "fuente_url": {
                "type": "string",
                "pattern": "^https://learn\\.microsoft\\.com/"
              },
              "consultado": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        },
        "region_fuente_url": {
          "type": "string",
          "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
        },
        "residencia": {
          "enum": [
            "geografia_tenant"
          ]
        },
        "residencia_fuente_url": {
          "type": "string",
          "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
        },
        "precios_items_ue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "swedencentral",
            "francecentral",
            "westeurope",
            "northeurope",
            "germanywestcentral",
            "spaincentral",
            "italynorth"
          ],
          "properties": {
            "swedencentral": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "francecentral": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "westeurope": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "northeurope": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "germanywestcentral": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "spaincentral": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "italynorth": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "regiones_con_restricciones": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region",
              "motivo",
              "fuente_url",
              "consultado"
            ],
            "properties": {
              "region": {
                "type": "string",
                "pattern": "^[a-z]+[a-z0-9]*$"
              },
              "motivo": {
                "type": "string",
                "minLength": 10,
                "maxLength": 400
              },
              "fuente_url": {
                "type": "string",
                "pattern": "^https://learn\\.microsoft\\.com/"
              },
              "consultado": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        },
        "region_precio": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "description": "armRegionName EXACTO (la API distingue mayúsculas) con el que Retail Prices publica el precio de un servicio que no tiene precio por región (p. ej. «Global»). Si existe, el filtro de todo precio del servicio lleva este armRegionName en vez de la región del componente."
        },
        "region_precio_comprobacion": {
          "$ref": "#/$defs/comprobacion_precio"
        },
        "plantillas_precio": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/plantilla_precio"
          }
        },
        "no_valorables": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/no_valorable"
          }
        },
        "niveles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "description": "I1.6 (decisión 4): niveles del servicio de menor a mayor, con sus plantillas y límites oficiales literales de Learn.",
          "items": {
            "$ref": "#/$defs/nivel"
          }
        },
        "incluye": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/inclusion"
          },
          "description": "I1.7: lo que el precio de este componente ya incluye (incluido_en_otro_componente exige esta declaración)."
        },
        "referencia_titulo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "description": "PR17-1 (arreglos I1.7): título publicado (h1) de la referencia_url en Learn; lo pone el núcleo."
        },
        "medidores_obligatorios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"
          },
          "description": "PR17-3 (arreglos I1.7): plantillas que un componente de esta fila con algún precio propio tiene que llevar (el medidor que más pesa: la capacidad de Storage, núcleos y memoria)."
        },
        "reglas_medidores": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "si_usa",
              "motivo",
              "fuente_url"
            ],
            "properties": {
              "si_usa": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"
                }
              },
              "exige": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"
                }
              },
              "exige_uno_de": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"
                }
              },
              "motivo": {
                "type": "string",
                "minLength": 20,
                "maxLength": 300
              },
              "fuente_url": {
                "type": "string",
                "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
              }
            }
          },
          "description": "I1.8 (REVERIF17-2): si el componente usa alguna plantilla de «si_usa», lleva todas las de «exige» y al menos una de «exige_uno_de». Propuesta al núcleo (CAMBIOS-I18-E §3)."
        },
        "nivel_por_defecto": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nivel",
            "fuente",
            "motivo",
            "consultado"
          ],
          "description": "I1.9 (VC18-1): nivel mínimo viable en producción con SLA, que no se justifica (fuera de la clase cómputo; en ella solo el cómputo por defecto). Lo lee experto.nivel_por_defecto.",
          "properties": {
            "nivel": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40
            },
            "fuente": {
              "type": "string",
              "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
            },
            "motivo": {
              "type": "string",
              "minLength": 20,
              "maxLength": 400
            },
            "consultado": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "disponibilidad": {
          "type": "object",
          "description": "I1.9 (VC18-3, VC18-11): {nivel (o modelo en Microsoft Foundry): {regiones, alcance, fuente, consultado, nota}}: las regiones de la UE del catálogo donde Learn lo da disponible; alcance «nivel» si Learn publica la tabla por nivel, «servicio» si solo por servicio. Un DISCREPA de región contra esto pasa a OBSERVACION (núcleo: verificacion.disponibilidad_catalogo). El validador de esquemas no admite claves libres con esquema: la forma de cada entrada la comprueba plantillas_precio.problemas_i19."
        }
      }
    },
    "comprobacion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fecha",
        "url_http",
        "url_titulo",
        "precios_items"
      ],
      "properties": {
        "fecha": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "url_http": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "url_titulo": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 300
        },
        "precios_items": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "fuente": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "http",
        "url_final",
        "titulo",
        "actualizado",
        "consultado"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
        },
        "http": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "url_final": {
          "type": "string",
          "pattern": "^https://learn\\.microsoft\\.com/"
        },
        "titulo": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "actualizado": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "consultado": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "comprobacion_precio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fecha",
        "filtro",
        "precios_items"
      ],
      "properties": {
        "fecha": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "filtro": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "precios_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "auxiliar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_name",
        "motivo",
        "nota",
        "comprobacion"
      ],
      "properties": {
        "service_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "productos": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          }
        },
        "region_precio": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "motivo": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "nota": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "comprobacion": {
          "$ref": "#/$defs/comprobacion_precio"
        },
        "componentes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "uniqueItems": true,
          "description": "INT15-3 y REV15-3 (I1.6): catalogo_id de los componentes a los que puede acompañar este precio auxiliar.",
          "items": {
            "type": "string",
            "pattern": "^az-[a-z0-9-]{2,40}$"
          }
        },
        "componentes_fuente_url": {
          "type": "string",
          "pattern": "^https://learn\\.microsoft\\.com/[a-z0-9/._-]+$"
        },
        "plantillas_de": {
          "type": "string",
          "pattern": "^az-[a-z0-9-]{2,40}$",
          "description": "Fila del catálogo con region_precio cuyas plantillas usa el auxiliar (INT15-3)."
        },
        "plantillas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
