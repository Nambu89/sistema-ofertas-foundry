lue="&lt;b&gt;Development&lt;/b&gt;&lt;br&gt;&lt;b&gt;DES-03&lt;/b&gt; IaC with azd and Bicep&lt;br&gt;&lt;b&gt;DES-04&lt;/b&gt; CI/CD with evaluations as a gate&lt;br&gt;&lt;b&gt;DES-05&lt;/b&gt; Small versions with rollback" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=13;fontColor=#505050;" vertex="1" parent="1"><mxGeometry x="30" y="922" width="310" height="82" as="geometry"/></mxCell><mxCell id="en-pilar-mantenibilidad" value="&lt;b&gt;Maintainability&lt;/b&gt;&lt;br&gt;&lt;b&gt;MAN-02&lt;/b&gt; Predictable state machine&lt;br&gt;&lt;b&gt;MAN-03&lt;/b&gt; Traces from every agent&lt;br&gt;&lt;b&gt;MAN-05&lt;/b&gt; Automation with OIDC, no secrets" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=13;fontColor=#505050;" vertex="1" parent="1"><mxGeometry x="340" y="922" width="310" height="82" as="geometry"/></mxCell><mxCell id="en-pilar-escalado" value="&lt;b&gt;Scalability&lt;/b&gt;&lt;br&gt;&lt;b&gt;ESC-03&lt;/b&gt; The right model for each role&lt;br&gt;&lt;b&gt;ESC-04&lt;/b&gt; Scales per project, down to zero&lt;br&gt;&lt;b&gt;ESC-05&lt;/b&gt; Index in Azure AI Search" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=13;fontColor=#505050;" vertex="1" parent="1"><mxGeometry x="650" y="922" width="310" height="82" as="geometry"/></mxCell><mxCell id="en-pilar-seguridad" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;&lt;b&gt;SEG-02&lt;/b&gt; Subscription and region segmentation&lt;br&gt;&lt;b&gt;SEG-03&lt;/b&gt; Per-agent identity, least privilege&lt;br&gt;&lt;b&gt;SEG-05&lt;/b&gt; Secrets in Azure Key Vault" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=13;fontColor=#505050;" vertex="1" parent="1"><mxGeometry x="960" y="922" width="310" height="82" as="geometry"/></mxCell><mxCell id="en-pilar-coste" value="&lt;b&gt;Cost&lt;/b&gt;&lt;br&gt;&lt;b&gt;COS-01&lt;/b&gt; Cost model with a budget&lt;br&gt;&lt;b&gt;COS-02&lt;/b&gt; Actual and forecast cost alerts" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=13;fontColor=#505050;" vertex="1" parent="1"><mxGeometry x="1270" y="922" width="310" height="82" as="geometry"/></mxCell><mxCell id="en-pilar-fiabilidad" value="&lt;b&gt;Reliability&lt;/b&gt;&lt;br&gt;&lt;b&gt;FIA-01&lt;/b&gt; One coordinator, one single writer&lt;br&gt;&lt;b&gt;FIA-04&lt;/b&gt; Native versioning and soft delete" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=13;fontColor=#505050;" vertex="1" parent="1"><mxGeometry x="1580" y="922" width="310" height="82" as="geometry"/></mxCell><mxCell id="en-leyenda" value="Legend: Flow step (1 to 8)   ·   Call or data   ·   Planned for later   ·   Traces and evaluations   ·   Validated in Azure (not the Content Safety icon's own check)   ·   Nested boundaries (tenant to region)   ·   Coordinator code   ·   Third party or no official icon" style="text;html=1;align=left;fontSize=13;fontColor=#505050;" vertex="1" parent="1"><mxGeometry x="24" y="1012" width="1872" height="24" as="geometry"/></mxCell><mxCell id="en-pie" value="Icons: Microsoft Azure Architecture Icons (V24) and Microsoft Entra architecture icons (Oct 2023), used under their terms (see ICONOS.md) · October 19, 2026" style="text;html=1;align=left;fontSize=13;fontColor=#505050;" vertex="1" parent="1"><mxGeometry x="24" y="1050" width="1200" height="22" as="geometry"/></mxCell><mxCell id="en-pie-derecha" value="Reference architecture with best practices · technical documentation" style="text;html=1;align=right;fontSize=13;fontColor=#505050;" vertex="1" parent="1"><mxGeometry x="1296" y="1050" width="600" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
