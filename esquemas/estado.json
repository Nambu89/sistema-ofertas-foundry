{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preventa:esquemas:estado:1",
  "title": "estado.json de una solicitud de preventa (I1)",
  "description": "Valida la forma. Los bloques requisitos, briefs[], respuestas_expertos.azure.respuesta, verificacion.respuesta, anexo_consumo, estimacion.entrada, textos_cliente y decisiones[] se validan además con su esquema propio. hash_contenido = SHA-256 del JSON canónico de 'carga' (CONTRATOS.md §5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "codigo", "version", "estado", "estado_previo", "motivo_bloqueo", "carga", "hash_contenido", "decisiones", "intentos", "ronda_verificacion", "fallos", "control_versiones", "artefactos"],
  "properties": {
    "schema": {"const": "preventa-estado/1"},
    "codigo": {"type": "string", "pattern": "^OF-[A-Z0-9]{2,20}-[0-9]{3}-[A-Z]$"},
    "version": {"type": "string", "pattern": "^[A-Z]$"},
    "estado": {"$ref": "#/$defs/nombre_estado"},
    "estado_previo": {"type": ["string", "null"], "enum": [null, "BORRADOR", "INFORMACION_INSUFICIENTE", "EN_ANALISIS", "EN_VERIFICACION", "VERIFICADA", "STOP_PRESUPUESTO", "LISTA_PARA_REVISION", "EN_REVISION_PREVENTA", "EN_APROBACION_AREA", "DEVUELTA_CON_COMENTARIOS"]},
    "motivo_bloqueo": {"type": ["string", "null"], "maxLength": 2000},
    "carga": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alta", "fuentes", "requisitos", "briefs", "respuestas_expertos", "consolidado", "verificacion", "anexo_consumo", "estimacion", "textos_cliente"],
      "properties": {
        "alta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cliente", "codigo_cliente", "seqof", "titulo", "terminos_sensibles", "nda_confirmado"],
          "properties": {
            "cliente": {"type": "string", "minLength": 2, "maxLength": 120},
            "codigo_cliente": {"type": "string", "pattern": "^[A-Z0-9]{2,20}$"},
            "seqof": {"type": "string", "pattern": "^[0-9]{3}$"},
            "titulo": {"type": "string", "minLength": 5, "maxLength": 160},
            "terminos_sensibles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 120}},
            "nda_confirmado": {"const": true}, "pilar": {"enum": ["azure", "gcp", "aws"], "description": "Multinube (esquemas/MULTINUBE.md): pilar de la solicitud. Sin la clave es azure (el estado de Azure no la escribe)."}
          }
        },
        "fuentes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "nombre", "tipo", "sha256", "bytes", "sha256_texto"],
            "properties": {
              "id": {"type": "string", "pattern": "^F[0-9]{1,2}$"},
              "nombre": {"type": "string", "minLength": 1, "maxLength": 255},
              "tipo": {"enum": ["TRANSCRIPCION", "ACLARACION", "NOTAS_COMERCIAL"]},
              "sha256": {"$ref": "#/$defs/hex64"},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256_texto": {"$ref": "#/$defs/hex64"}
            }
          }
        },
        "requisitos": {"type": ["object", "null"]},
        "briefs": {"type": "array", "items": {"type": "object"}},
        "respuestas_expertos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "azure": {"$ref": "#/$defs/registro_experto"}, "gcp": {"$ref": "#/$defs/registro_experto"}, "aws": {"$ref": "#/$defs/registro_experto"}
          }
        },
        "consolidado": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["consolidado_id", "sha256", "texto", "ids"],
          "properties": {
            "consolidado_id": {"type": "string", "pattern": "^CNS-OF-[A-Z0-9]{2,20}-[0-9]{3}-[A-Z]-R[1-3]$"},
            "sha256": {"$ref": "#/$defs/hex64"},
            "texto": {"type": "string", "minLength": 50, "maxLength": 40960},
            "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(REF|C|P|S|RG)-[0-9]{2}$"}},
            "lotes": {
              "description": "Lotes que se envían al verificador (LES-G-096): partición de ids por tipo, con la respuesta literal de cada llamada cuando se registra. Opcional: los estados anteriores a los lotes no lo llevan.",
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lote_id", "tipo", "sha256", "texto", "ids", "registrada_el", "respuesta"],
                "properties": {
                  "lote_id": {"type": "string", "pattern": "^CNS-OF-[A-Z0-9]{2,20}-[0-9]{3}-[A-Z]-R[1-3]-L[0-9]{1,2}$"},
                  "tipo": {"enum": ["referencias", "componentes", "precios"]},
                  "sha256": {"$ref": "#/$defs/hex64"},
                  "texto": {"type": "string", "minLength": 50, "maxLength": 20480},
                  "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(REF|C|P)-[0-9]{2}$"}},
                  "registrada_el": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                  "respuesta": {"type": ["object", "null"]}
                }
              }
            }
          }
        },
        "verificacion": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["registrada_el", "consolidado_id", "respuesta", "resultado"],
          "properties": {
            "registrada_el": {"$ref": "#/$defs/fecha"},
            "consolidado_id": {"type": "string", "minLength": 10},
            "respuesta": {"type": "object"},
            "resultado": {
              "type": "object",
              "additionalProperties": false,
              "required": ["verificada", "discrepa", "no_verificables", "reparados"],
              "properties": {
                "verificada": {"type": "boolean"},
                "discrepa": {"type": "array", "items": {"type": "object"}},
                "no_verificables": {"type": "array", "items": {"type": "object"}},
                "reparados": {"type": "array", "items": {"type": "object"}}
              }
            },
            "lotes": {"description": "Ids de los lotes combinados en respuesta; [] si llegó una respuesta completa. Opcional en estados anteriores.", "type": "array", "items": {"type": "string", "minLength": 10}},
            "observaciones": {"description": "OBSERVACION del verificador (editorial o de regla, sin fuente): no bloquean y van a la nota del revisor (LES-G-096). Opcional en estados anteriores.", "type": "array", "items": {"type": "object"}}
          }
        },
        "anexo_consumo": {"type": ["object", "null"]},
        "estimacion": {"$ref": "#/$defs/estimacion"},
        "textos_cliente": {"type": ["object", "null"]}
      }
    },
    "hash_contenido": {"$ref": "#/$defs/hex64"},
    "decisiones": {"type": "array", "items": {"type": "object"}},
    "intentos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["T1", "T2", "T3", "T4"],
      "properties": {
        "T1": {"type": "integer", "minimum": 0, "maximum": 3},
        "T2": {"type": "integer", "minimum": 0, "maximum": 3},
        "T3": {"type": "integer", "minimum": 0, "maximum": 3},
        "T4": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "ronda_verificacion": {"type": "integer", "minimum": 0, "maximum": 3},
    "fallos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ts", "fase", "intento", "error", "hipotesis"],
        "properties": {
          "ts": {"type": "string", "minLength": 19, "maxLength": 40},
          "fase": {"enum": ["T1", "T2", "T3", "T4"]},
          "intento": {"type": "integer", "minimum": 1, "maximum": 3},
          "error": {"type": "string", "minLength": 3, "maxLength": 8000},
          "hipotesis": {"type": "string", "minLength": 3, "maxLength": 2000}
        }
      }
    },
    "control_versiones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "subcomando", "estado_antes", "estado_despues", "hash_antes", "hash_despues", "ts"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "subcomando": {"type": "string", "minLength": 3, "maxLength": 40},
          "estado_antes": {"type": ["string", "null"]},
          "estado_despues": {"type": "string"},
          "hash_antes": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "hash_despues": {"$ref": "#/$defs/hex64"},
          "ts": {"type": "string", "minLength": 19, "maxLength": 40}
        }
      }
    },
    "orquestador": {"enum": ["A", "B"], "description": "VER14-3 / REV-5 (I1.5): orquestador que ejecutó el último paso guardado (PREVENTA_ORQUESTADOR; A por defecto). Opcional: los estados anteriores a I1.5 no lo traen."},
    "artefactos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xlsx_estimacion", "anexo_xlsx", "anexo_json", "pptx", "docx", "zip"],
      "properties": {
        "xlsx_estimacion": {"$ref": "#/$defs/artefacto"},
        "anexo_xlsx": {"$ref": "#/$defs/artefacto"},
        "anexo_json": {"$ref": "#/$defs/artefacto"},
        "pptx": {"$ref": "#/$defs/artefacto"},
        "docx": {"$ref": "#/$defs/artefacto"},
        "zip": {"$ref": "#/$defs/artefacto"}
      }
    }
  },
  "$defs": {
    "registro_experto": {
              "type": "object",
              "additionalProperties": false,
              "required": ["registrada_el", "brief_id", "respuesta"],
              "properties": {
                "registrada_el": {"$ref": "#/$defs/fecha"},
                "brief_id": {"type": "string", "minLength": 10},
                "respuesta": {"type": "object"},
                "ajustes_nucleo": {
                  "description": "I1.6 (VER15-3, CAMBIOS-I16-P §5.3): conceptos de precio que el núcleo fijó desde la plantilla cuando el experto traía otro texto; van a la nota del revisor. Solo existe si hubo alguna sustitución.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["conceptos"],
                  "properties": {
                    "conceptos": {"type": "array", "maxItems": 30, "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["precio_id", "plantilla", "recibido", "fijado"],
                      "properties": {
                        "precio_id": {"type": "string", "pattern": "^P-[0-9]{2}$"},
                        "plantilla": {"type": "string", "minLength": 1, "maxLength": 60},
                        "recibido": {"type": "string", "maxLength": 160},
                        "fijado": {"type": "string", "minLength": 3, "maxLength": 160}
                      }
                    }}
                  }
                }
              }
            },
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fecha": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "nombre_estado": {"enum": ["BORRADOR", "INFORMACION_INSUFICIENTE", "EN_ANALISIS", "EN_VERIFICACION", "VERIFICADA", "STOP_PRESUPUESTO", "LISTA_PARA_REVISION", "EN_REVISION_PREVENTA", "EN_APROBACION_AREA", "APROBADA", "DEVUELTA_CON_COMENTARIOS", "BLOQUEADA"]},
    "artefacto": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["nombre", "sha256", "bytes"],
      "properties": {
        "nombre": {"type": "string", "minLength": 3, "maxLength": 255},
        "sha256": {"$ref": "#/$defs/hex64"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "importe": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
    "horas": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "estimacion": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["entrada", "resumen", "ajuste"],
      "properties": {
        "entrada": {"type": "object"},
        "resumen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["horas_total", "por_perfil", "por_fase", "pm_h", "pm_pct", "subtotal_eur", "ajuste_eur", "precio_cerrado_eur", "hitos", "duracion_semanas"],
          "properties": {
            "horas_total": {"$ref": "#/$defs/horas"},
            "por_perfil": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["perfil", "horas", "tarifa_hora", "importe_eur"], "properties": {"perfil": {"type": "string"}, "horas": {"$ref": "#/$defs/horas"}, "tarifa_hora": {"type": "number", "minimum": 0}, "importe_eur": {"$ref": "#/$defs/importe"}}}},
            "por_fase": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["fase", "horas"], "properties": {"fase": {"type": "string"}, "horas": {"$ref": "#/$defs/horas"}}}},
            "pm_h": {"$ref": "#/$defs/horas"},
            "pm_pct": {"$ref": "#/$defs/horas"},
            "subtotal_eur": {"$ref": "#/$defs/importe"},
            "ajuste_eur": {"$ref": "#/$defs/importe"},
            "precio_cerrado_eur": {"$ref": "#/$defs/importe"},
            "hitos": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["nombre", "porcentaje", "importe_eur"], "properties": {"nombre": {"type": "string"}, "porcentaje": {"type": "number"}, "importe_eur": {"$ref": "#/$defs/importe"}}}},
            "duracion_semanas": {"type": "integer", "minimum": 1, "maximum": 104}
          }
        },
        "ajuste": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["decision_id", "importe_eur", "motivo", "hash_base"],
          "properties": {
            "decision_id": {"type": "string", "pattern": "^D-[0-9]{3}$"},
            "importe_eur": {"$ref": "#/$defs/importe"},
            "motivo": {"type": "string", "minLength": 10, "maxLength": 400},
            "hash_base": {"$ref": "#/$defs/hex64"}
          }
        }
      }
    }
  }
}
