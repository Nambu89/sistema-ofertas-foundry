{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preventa:esquemas:respuesta_verificador:1",
  "title": "Respuesta de preventa-verificador (A2A)",
  "description": "HISTÓRICO, congelado el 08-10-2026: contrato de la versión A (I1), anterior a los lotes y a OBSERVACION. Solo sirve para validar estados y paquetes de la versión A en local (verificar_paquete.py); las respuestas nuevas se validan con esquemas/respuesta_verificador.json. Discriminante: herramientas_usadas sin precios_azure. Texto original: Un veredicto por cada id del consolidado (ni más ni menos). Compatible con text.format json_schema strict (misma nota que respuesta_experto). Para precios, valor_correcto es un decimal con punto. CONTRATOS.md §7.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agente", "consolidado_id", "entrada_recibida_inicio", "elementos", "resumen", "herramientas_usadas"],
  "properties": {
    "agente": {"enum": ["preventa-verificador"]},
    "consolidado_id": {"type": "string", "pattern": "^CNS-OF-[A-Z0-9]{2,20}-[0-9]{3}-[A-Z]-R[1-3]$"},
    "entrada_recibida_inicio": {"type": "string", "minLength": 20, "maxLength": 200},
    "elementos": {"type": "array", "minItems": 1, "maxItems": 120, "items": {"$ref": "#/$defs/elemento"}},
    "resumen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "discrepa", "no_verificable"],
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "discrepa": {"type": "integer", "minimum": 0},
        "no_verificable": {"type": "integer", "minimum": 0}
      }
    },
    "herramientas_usadas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["microsoft_docs_search", "microsoft_docs_fetch"],
      "properties": {
        "microsoft_docs_search": {"type": "integer", "minimum": 0, "maximum": 6},
        "microsoft_docs_fetch": {"type": "integer", "minimum": 0, "maximum": 6}
      }
    }
  },
  "$defs": {
    "elemento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tipo", "veredicto", "detalle", "valor_correcto", "fuente_url"],
      "properties": {
        "id": {"type": "string", "pattern": "^(REF|C|P|S|RG)-[0-9]{2}$"},
        "tipo": {"enum": ["referencia", "componente", "precio", "texto"]},
        "veredicto": {"enum": ["OK", "DISCREPA", "NO VERIFICABLE"]},
        "detalle": {"type": "string", "minLength": 3, "maxLength": 600},
        "valor_correcto": {"type": ["string", "null"], "maxLength": 600},
        "fuente_url": {"type": ["string", "null"], "pattern": "^https://(learn\\.microsoft\\.com|prices\\.azure\\.com)/"}
      }
    }
  }
}
