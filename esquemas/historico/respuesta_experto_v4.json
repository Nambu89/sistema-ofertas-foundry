{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preventa:esquemas:respuesta_experto:4",
  "title": "Respuesta de preventa-experto-azure (A2A), contrato v4",
  "description": "Lo que escribe el modelo. Compatible con text.format json_schema strict: todas las propiedades en required y additionalProperties false en cada objeto; la versión derivada (agentes/esquemas/respuesta_experto.text_format.json) quita patrones y límites y este esquema completo lo aplica el código. v4 (I1.7, decisiones del comercial del 13-10-2026): el modelo ya no escribe filtro, precio, unidad, moneda, región, vigencia, concepto ni cantidad_mensual de un precio, ni la referencia de un componente del catálogo, ni la URL de la arquitectura. Por cada línea de consumo escribe la plantilla del catálogo (plantilla_id), las instancias (medidores de tiempo; null = 1), la base de volumen (cita literal de la volumetría, número de la cita y su unidad) y, solo si un requisito citado lo obliga, factor_override; el núcleo pone el filtro de la plantilla, el precio de la instantánea descargada al desplegar, la unidad, el concepto, el factor estándar del catálogo, la cantidad (tiempo: 730 h × instancias; volumen: cantidad_base × factor ÷ divisor) y la referencia de cada componente del catálogo, y guarda el resultado con el esquema respuesta_experto_completa. La arquitectura de referencia se elige por id (arquitectura_id) de la lista del catálogo. referencia_id solo la escribe el modelo para un componente sin catalogo_id (para uno del catálogo va null). motivo_cita: cita literal de una entrada de «Lo que el cliente ya tiene o paga» (requisitos.ya_contratado_por_cliente) que nombre el servicio del componente (a_cargo_del_cliente; REV17-3, I1.8); incluido_en: componente que lo incluye (incluido_en_otro_componente; el catálogo tiene que declarar la inclusión con fuente). La v3 queda en historico/respuesta_experto_v3. CONTRATOS.md §6.4 y docs/I1/CAMBIOS-I17-P.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["brief_recibido", "brief_id", "agente", "arquitectura_id", "referencias", "componentes", "flujos", "decisiones", "alternativas_descartadas", "supuestos", "riesgos", "preguntas", "tareas_propuestas", "precios", "herramientas_usadas"],
  "properties": {
    "brief_recibido": {"type": "string", "minLength": 200, "maxLength": 20480},
    "brief_id": {"type": "string", "pattern": "^BRF-OF-[A-Z0-9]{2,20}-[0-9]{3}-[A-Z]-AZ-R[1-3]$"},
    "agente": {"enum": ["preventa-experto-azure"]},
    "arquitectura_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,59}$"},
    "referencias": {"type": "array", "maxItems": 15, "items": {"$ref": "#/$defs/referencia"}},
    "componentes": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/componente"}},
    "flujos": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/flujo"}},
    "decisiones": {"type": "array", "maxItems": 15, "items": {"type": "string", "minLength": 5, "maxLength": 400}},
    "alternativas_descartadas": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 5, "maxLength": 400}},
    "supuestos": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/supuesto"}},
    "riesgos": {"type": "array", "maxItems": 15, "items": {"$ref": "#/$defs/riesgo"}},
    "preguntas": {"type": "array", "maxItems": 15, "items": {"type": "string", "minLength": 5, "maxLength": 400}},
    "tareas_propuestas": {"type": "array", "minItems": 1, "maxItems": 40, "items": {"$ref": "#/$defs/tarea"}},
    "precios": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/precio"}},
    "herramientas_usadas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["microsoft_docs_search", "microsoft_docs_fetch"],
      "properties": {
        "microsoft_docs_search": {"type": "integer", "minimum": 0, "maximum": 3},
        "microsoft_docs_fetch": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    }
  },
  "$defs": {
    "referencia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "titulo", "fecha_consulta"],
      "properties": {
        "id": {"type": "string", "pattern": "^REF-[0-9]{2}$"},
        "url": {"type": "string", "pattern": "^https://learn\\.microsoft\\.com/"},
        "titulo": {"type": "string", "minLength": 5, "maxLength": 200},
        "fecha_consulta": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "componente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "catalogo_id", "servicio", "capa", "sku", "region", "cantidad", "unidad", "referencia_id", "desviacion_justificada", "motivo_no_valoracion", "motivo_cita", "incluido_en", "justificacion_nivel"],
      "properties": {
        "id": {"type": "string", "pattern": "^C-[0-9]{2}$"},
        "catalogo_id": {"type": ["string", "null"], "pattern": "^az-[a-z0-9-]{2,40}$"},
        "servicio": {"type": "string", "minLength": 3, "maxLength": 120},
        "capa": {"enum": ["usuarios_canales", "aplicacion_integracion", "ia", "datos_conocimiento", "identidad_seguridad_red", "operacion_observabilidad"]},
        "sku": {"type": "string", "minLength": 1, "maxLength": 80},
        "region": {"type": "string", "pattern": "^([a-z]+[a-z0-9]*|global)$"},
        "cantidad": {"type": "number", "exclusiveMinimum": 0},
        "unidad": {"type": "string", "minLength": 1, "maxLength": 60},
        "referencia_id": {"type": ["string", "null"], "pattern": "^REF-[0-9]{2}$"},
        "desviacion_justificada": {"type": ["string", "null"], "minLength": 30, "maxLength": 600},
        "motivo_no_valoracion": {"enum": ["no_aplica", "depende_del_volumen", "sin_medidor_publico", "a_cargo_del_cliente", "incluido_en_otro_componente", "licencia_fuera_de_azure", "fuera_del_catalogo"]},
        "motivo_cita": {"type": ["string", "null"], "minLength": 2, "maxLength": 600},
        "incluido_en": {"type": ["string", "null"], "pattern": "^C-[0-9]{2}$"},
        "justificacion_nivel": {"$ref": "#/$defs/justificacion_nivel"}
      }
    },
    "flujo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origen", "destino", "descripcion"],
      "properties": {
        "origen": {"type": "string", "pattern": "^C-[0-9]{2}$"},
        "destino": {"type": "string", "pattern": "^C-[0-9]{2}$"},
        "descripcion": {"type": "string", "minLength": 3, "maxLength": 200}
      }
    },
    "supuesto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "texto", "confianza", "hechos"],
      "properties": {
        "id": {"type": "string", "pattern": "^S-[0-9]{2}$"},
        "texto": {"type": "string", "minLength": 10, "maxLength": 300},
        "confianza": {"enum": ["ALTA", "MEDIA", "BAJA"]},
        "hechos": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/id_hecho"}}
      }
    },
    "riesgo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "texto", "mitigacion", "hechos"],
      "properties": {
        "id": {"type": "string", "pattern": "^RG-[0-9]{2}$"},
        "texto": {"type": "string", "minLength": 10, "maxLength": 300},
        "mitigacion": {"type": "string", "minLength": 10, "maxLength": 300},
        "hechos": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/id_hecho"}}
      }
    },
    "tarea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fase", "tarea", "perfil", "horas_base", "reuniones_h", "descripcion", "entregable"],
      "properties": {
        "id": {"type": "string", "pattern": "^T-[0-9]{2}$"},
        "fase": {"type": "string", "minLength": 3, "maxLength": 80},
        "tarea": {"type": "string", "minLength": 3, "maxLength": 160},
        "perfil": {"type": "string", "minLength": 3, "maxLength": 80},
        "horas_base": {"type": "number", "minimum": 1, "maximum": 400},
        "reuniones_h": {"type": "number", "minimum": 0, "maximum": 80},
        "descripcion": {"type": "string", "minLength": 10, "maxLength": 400},
        "entregable": {"type": "string", "minLength": 3, "maxLength": 200}
      }
    },
    "precio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componente_id", "plantilla_id", "instancias", "base_volumen", "factor_override"],
      "properties": {
        "id": {"type": "string", "pattern": "^P-[0-9]{2}$"},
        "componente_id": {"type": "string", "pattern": "^C-[0-9]{2}$"},
        "plantilla_id": {"type": "string", "pattern": "^(az-[a-z0-9-]{2,40}/)?[a-z0-9][a-z0-9.-]{0,59}$"},
        "instancias": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000},
        "base_volumen": {"$ref": "#/$defs/base_volumen"},
        "factor_override": {"$ref": "#/$defs/factor_override"}
      }
    },
    "base_volumen": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["cita", "cantidad_base", "unidad_base"],
      "properties": {
        "cita": {"type": "string", "minLength": 2, "maxLength": 600},
        "cantidad_base": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000},
        "unidad_base": {"type": "string", "minLength": 1, "maxLength": 60}
      }
    },
    "factor_override": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["valor", "cita", "justificacion"],
      "properties": {
        "valor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000},
        "cita": {"type": "string", "minLength": 2, "maxLength": 600},
        "justificacion": {"type": "string", "minLength": 10, "maxLength": 300}
      }
    },
    "justificacion_nivel": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["nivel", "requisito", "limite_oficial", "fuente"],
      "properties": {
        "nivel": {"type": "string", "minLength": 1, "maxLength": 60},
        "requisito": {"type": "string", "minLength": 2, "maxLength": 600},
        "limite_oficial": {"type": "string", "minLength": 3, "maxLength": 400},
        "fuente": {"type": "string", "pattern": "^https://learn\\.microsoft\\.com/"}
      }
    },
    "id_hecho": {"type": "string", "pattern": "^(R-[a-z_]+|REF-[0-9]{2}|C-[0-9]{2}|P-[0-9]{2})$"}
  }
}
