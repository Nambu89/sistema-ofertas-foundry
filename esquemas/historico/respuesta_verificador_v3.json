{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preventa:esquemas:respuesta_verificador:3",
  "title": "Respuesta de preventa-verificador (A2A)",
  "description": "HISTÓRICO (I1.4 a I1.6, congelado en I1.7): contrato v3 del verificador, con precios y herramienta precios_azure. La puerta lo usa para las respuestas guardadas de su época (herramientas_usadas con precios_azure). Un veredicto por cada id de lo enviado (un lote o el consolidado completo), ni más ni menos. Solo se verifican referencias, componentes y precios; la prosa no se envía (LES-G-096). DISCREPA = discrepancia de hecho: exige valor_correcto, fuente_url y el campo de la línea que discute (campo; ARR13-4: solo se reclasifica a OBSERVACION si ese campo es el nombre o el título y el valor correcto es lo enviado) y bloquea si la fuente no es válida. En los demás veredictos campo es ninguno o el campo al que se refiere la observación. entrada_recibida_inicio = las tres primeras líneas completas de lo recibido, separadas por saltos de línea, que el código compara línea a línea (EA-3). OBSERVACION = editorial o de regla, sin fuente: no bloquea y va a la nota del revisor. Para precios, valor_correcto es un decimal con punto. En carga.verificacion.respuesta, si hubo lotes, el código combina las respuestas: elementos literales, resumen recalculado y herramientas_usadas con el máximo por llamada. Compatible con text.format json_schema strict (misma nota que respuesta_experto). CONTRATOS.md §7.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agente",
    "consolidado_id",
    "entrada_recibida_inicio",
    "elementos",
    "resumen",
    "herramientas_usadas"
  ],
  "properties": {
    "agente": {
      "enum": [
        "preventa-verificador"
      ]
    },
    "consolidado_id": {
      "type": "string",
      "pattern": "^CNS-OF-[A-Z0-9]{2,20}-[0-9]{3}-[A-Z]-R[1-3](-L[0-9]{1,2})?$"
    },
    "entrada_recibida_inicio": {
      "type": "string",
      "minLength": 20,
      "maxLength": 300
    },
    "elementos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65,
      "items": {
        "$ref": "#/$defs/elemento"
      }
    },
    "resumen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "discrepa",
        "observacion",
        "no_verificable"
      ],
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "discrepa": {
          "type": "integer",
          "minimum": 0
        },
        "observacion": {
          "type": "integer",
          "minimum": 0
        },
        "no_verificable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "herramientas_usadas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "microsoft_docs_search",
        "microsoft_docs_fetch",
        "precios_azure"
      ],
      "properties": {
        "microsoft_docs_search": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "microsoft_docs_fetch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "precios_azure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      }
    }
  },
  "$defs": {
    "elemento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tipo",
        "veredicto",
        "campo",
        "detalle",
        "valor_correcto",
        "fuente_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(REF|C|P)-[0-9]{2}$"
        },
        "tipo": {
          "enum": [
            "referencia",
            "componente",
            "precio"
          ]
        },
        "veredicto": {
          "enum": [
            "OK",
            "DISCREPA",
            "OBSERVACION",
            "NO VERIFICABLE"
          ]
        },
        "campo": {
          "enum": [
            "ninguno",
            "url",
            "titulo",
            "nombre",
            "sku",
            "region",
            "referencia",
            "componente",
            "filtro",
            "precio",
            "unidad",
            "effectiveStartDate",
            "cantidad"
          ]
        },
        "detalle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 600
        },
        "valor_correcto": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600
        },
        "fuente_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://(learn\\.microsoft\\.com|prices\\.azure\\.com)/"
        }
      }
    }
  }
}
