{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preventa:esquemas:anexo_consumo:1",
  "title": "Anexo de consumo cloud orientativo (carga.anexo_consumo y <codigo>-Anexo-Consumo.json)",
  "description": "Lo calcula anexo_consumo.calcular sin nada escrito por el modelo: precio unitario y cantidad mensual de la respuesta del experto, estado de verificación de la respuesta del verificador. coste_mensual_eur = precio_unitario x cantidad_mensual con Decimal y ROUND_HALF_UP a céntimos. No forma parte del precio cerrado.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "codigo", "moneda", "fuente", "lineas", "total_mensual_eur", "total_anual_eur", "avisos", "nota_fija"],
  "properties": {
    "schema": {"const": "preventa-anexo-consumo/1"},
    "codigo": {"type": "string", "pattern": "^OF-[A-Z0-9]{2,20}-[0-9]{3}-[A-Z]$"},
    "moneda": {"enum": ["EUR"]},
    "fuente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nombre", "url", "consultado_el"],
      "properties": {
        "nombre": {"enum": ["Azure Retail Prices", "Google Cloud Billing Catalog", "AWS Price List"]},
        "url": {"enum": ["https://prices.azure.com/api/retail/prices", "https://cloudbilling.googleapis.com/v1/services", "https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/index.json"]},
        "consultado_el": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "fuente_moneda": {"enum": ["gcp_catalog_eur", "aws_usd_convertido_bce"], "description": "Multinube (esquemas/MULTINUBE.md): procedencia del euro fuera de Azure (Azure no la escribe)."},
        "tipo_bce": {"type": "number", "exclusiveMinimum": 0, "description": "Solo AWS: 1 EUR = tipo_bce USD."},
        "fecha_tipo_bce": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "lineas": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["precio_id", "componente_id", "servicio", "concepto", "region", "filtro", "precio_unitario", "unidad", "cantidad_mensual", "supuesto_cantidad", "effectiveStartDate", "coste_mensual_eur", "verificacion"],
        "properties": {
          "precio_id": {"type": "string", "pattern": "^P-[0-9]{2}$"},
          "componente_id": {"type": "string", "pattern": "^C-[0-9]{2}$"},
          "servicio": {"type": "string", "minLength": 3, "maxLength": 120},
          "concepto": {"type": "string", "minLength": 3, "maxLength": 160},
          "region": {"type": "string", "minLength": 3, "maxLength": 40},
          "filtro": {"type": "string", "minLength": 10, "maxLength": 500},
          "precio_unitario": {"type": "number", "minimum": 0},
          "unidad": {"type": "string", "minLength": 1, "maxLength": 40},
          "cantidad_mensual": {"type": "number", "exclusiveMinimum": 0},
          "supuesto_cantidad": {"type": "string", "minLength": 10, "maxLength": 300},
          "effectiveStartDate": {"type": "string", "minLength": 10, "maxLength": 30},
          "coste_mensual_eur": {"$ref": "#/$defs/importe"},
          "verificacion": {"enum": ["OK", "REPARADO", "NO VERIFICABLE"]}
        }
      }
    },
    "total_mensual_eur": {"$ref": "#/$defs/importe"},
    "total_anual_eur": {"$ref": "#/$defs/importe"},
    "avisos": {"type": "array", "items": {"type": "string", "minLength": 5, "maxLength": 300}},
    "nota_fija": {"const": "Orientativo. No incluido en el precio cerrado; lo asume el cliente."}
  },
  "$defs": {
    "importe": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"}
  }
}
